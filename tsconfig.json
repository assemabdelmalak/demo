{
  // Root-level config files and the Playwright suite; each is run by its own tool (Vitest,
  // Playwright), which resolves modules like a bundler.
  "extends": "@radd/config/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["*.ts", "e2e/**/*.ts"],
  "exclude": ["node_modules", "apps", "packages"]
}
