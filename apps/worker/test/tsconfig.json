{
  // Vitest runs tests as ES modules (top-level await, import.meta), unlike the CommonJS app build.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    // `apps/`: the notify.email test imports the API's queue producer by path (test-only).
    "rootDir": "${configDir}/../.."
  },
  "include": ["."]
}
