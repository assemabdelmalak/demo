{
  "name": "@radd/config",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./tsconfig/*.json": "./tsconfig/*.json",
    "./eslint/base": "./eslint/base.js",
    "./eslint/nest": "./eslint/nest.js",
    "./eslint/react": "./eslint/react.js",
    "./eslint/next": "./eslint/next.js",
    "./prettier": "./prettier/index.js",
    "./env": {
      "@radd/source": "./src/env/index.ts",
      "types": "./dist/env/index.d.ts",
      "default": "./dist/env/index.js"
    },
    "./testing": {
      "@radd/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./vitest": {
      "@radd/source": "./src/vitest/index.ts",
      "types": "./dist/vitest/index.d.ts",
      "default": "./dist/vitest/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run -c vitest.int.config.ts"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.72.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/valkey": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.6",
    "eslint": "10.13.0",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "testcontainers": "12.2.1",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist",
    "eslint",
    "prettier",
    "tsconfig"
  ]
}
