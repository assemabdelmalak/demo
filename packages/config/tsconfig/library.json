{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Radd library (ESM, emits to dist)",
  "extends": "./base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src"
  },
  "include": ["${configDir}/src"]
}
