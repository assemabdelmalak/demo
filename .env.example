# ─────────────────────────────────────────────────────────────
# Radd Menu — environment variables
# Copy to .env (local). In staging/production set these in Coolify.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# General
NODE_ENV=development
APP_ENV=local                      # local | staging | production
APP_DOMAIN=localhost               # production: your domain, e.g. raddmenu.com
GIT_SHA=dev
APP_VERSION=0.0.0

# Public URLs
DINER_PUBLIC_URL=http://localhost:3000
CONSOLE_PUBLIC_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:4000
CDN_PUBLIC_URL=http://localhost:9000/radd-assets
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CDN_URL=http://localhost:9000/radd-assets

# Ports
API_PORT=4000
WORKER_HEALTH_PORT=4100                  # worker liveness probe

# Database (Postgres 17)
DATABASE_URL=postgres://app_runtime:app_runtime@localhost:5432/radd        # runtime role (RLS enforced)
DATABASE_URL_MIGRATOR=postgres://app_migrator:app_migrator@localhost:5432/radd
DATABASE_URL_ADMIN=postgres://app_admin:app_admin@localhost:5432/radd      # super-admin module only
DATABASE_POOL_MAX=20

# Valkey (Redis-compatible)
REDIS_URL=redis://:valkey@localhost:6379/0

# Auth & tokens (generate: openssl rand -base64 48)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:4000/v1/auth
AUTH_COOKIE_DOMAIN=localhost
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
PARTICIPANT_TOKEN_SECRET=change-me
DEVICE_COOKIE_SECRET=change-me
RECEIPT_TOKEN_SECRET=change-me
DINER_REVALIDATE_SECRET=change-me
SUPER_ADMIN_EMAILS=admin@radd.test

# Object storage (MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_BUCKET_PUBLIC=radd-assets
S3_BUCKET_PRIVATE=radd-private
S3_FORCE_PATH_STYLE=true

# AI — Anthropic (verify model IDs in docs before launch)
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL_CHAT=claude-haiku-5-5
AI_MODEL_CLASSIFY=claude-haiku-5-5
AI_MODEL_IMPORT=claude-sonnet-5-5
AI_MODEL_IMPORT_FALLBACK=claude-opus-5-5
AI_MODEL_TRANSLATE=claude-sonnet-5-5
AI_MODEL_ALLERGEN_SUGGEST=claude-sonnet-5-5
AI_MODEL_INSIGHTS_CLASSIFY=claude-haiku-5-5
AI_MODEL_INSIGHTS_SUMMARY=claude-sonnet-5-5
AI_CHAT_EFFORT=low
AI_CACHE_TTL=5m                    # 5m | 1h
AI_MONTHLY_BUDGET_USD=100          # global kill switch
EVAL_BUDGET_USD=5

# LLM observability (Langfuse Cloud or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Email
MAIL_PROVIDER=smtp                 # smtp (Mailpit locally) | resend
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
EMAIL_FROM="Radd Menu <no-reply@localhost>"

# WhatsApp Cloud API (Meta) — Phase 9
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0       # check current Graph API version

# Observability
SENTRY_DSN_API=
SENTRY_DSN_WORKER=
NEXT_PUBLIC_SENTRY_DSN_DINER=
NEXT_PUBLIC_SENTRY_DSN_CONSOLE=
LOG_LEVEL=info

# Cloudflare (optional: cache purge on publish)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ─────────────────────────────────────────────────────────────
# CI only (GitHub Actions secrets/vars) — not read by the apps at runtime
# ─────────────────────────────────────────────────────────────
# SENTRY_AUTH_TOKEN=                # source-map upload; passed to docker builds as a BuildKit secret
# SENTRY_ORG=
# SENTRY_PROJECT_API=
# SENTRY_PROJECT_WORKER=
# SENTRY_PROJECT_DINER=
# SENTRY_PROJECT_CONSOLE=
