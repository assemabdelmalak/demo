{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Beirut",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "pin",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group minor and patch updates into one weekly PR",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "weekly minor and patch",
      "groupSlug": "weekly-minor-patch"
    },
    {
      "description": "Majors that ADR-011 holds back need a new ADR before upgrading",
      "matchPackageNames": ["typescript", "@nestjs/**", "node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
